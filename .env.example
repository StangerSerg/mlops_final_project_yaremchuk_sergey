# Скопируйте в .env и заполните под своё окружение: cp .env.example .env
# .env в git не коммитится. В CI те же имена задаются в GitLab CI/CD Variables
# (ключи — masked + protected).
#
# Если S3_BUCKET или ключи пустые — S3 не используется, данные и модель
# берутся из локальных каталогов LOCAL_*_DIR (fallback).

# ---------- S3 (Yandex Object Storage) ----------
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_PREFIX=yaremchuk_sergey_project
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Подкаталоги внутри S3_PREFIX
S3_RAW_DIR=raw_data
S3_PROCESSED_DIR=processed_data
S3_MODELS_DIR=models
# Полный ключ модели в бакете, если она лежит не в S3_PREFIX/models
# (например, лучшая модель из пайплайна ClearML). Пусто — по умолчанию.
MODEL_S3_KEY=

# ---------- Локальные каталоги (кэш S3 и fallback) ----------
LOCAL_RAW_DIR=data/raw
LOCAL_PROCESSED_DIR=data/prepared
LOCAL_MODELS_DIR=models

# ---------- Сервис ----------
APP_HOST=0.0.0.0
APP_PORT=32000
CONFIG_PATH=config/config.json
LOG_PATH=logs/app.log
# text — для локальной разработки, json — для сбора логов в Loki
LOG_FORMAT=text

# ---------- ClearML (пайплайн обучения mlops/clearml) ----------
# Ключи: ClearML Web UI → Settings → Workspace → Create new credentials
CLEARML_API_HOST=http://localhost:8008
CLEARML_WEB_HOST=http://localhost:8080
CLEARML_FILES_HOST=http://localhost:8081
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
CLEARML_PROJECT=mlops
# Репозиторий, который clearml-agent клонирует для шагов (только --mode remote)
CLEARML_PIPELINE_REPO=

# ---------- Airflow (препроцессинг mlops/airflow) ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_PORT=8080
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=

# ---------- Kubernetes (mlops/deploy/k8s/deploy.sh) ----------
K8S_NAMESPACE=
# Образ из GitLab Container Registry, например registry.example.com/group/project:latest
K8S_IMAGE=
# Deploy token GitLab (read_registry) для pull образа; пусто — без imagePullSecret
REGISTRY=
REGISTRY_USER=
REGISTRY_PASSWORD=
# Имя модели в V2 API: /v2/models/$MODEL_NAME/infer
MODEL_NAME=ranker
MODEL_VERSION=1

# ---------- ВМ: сервис + мониторинг (mlops/deploy/vm/docker-compose.yml) ----------
# Образ из GitLab Registry; пусто — собрать локально
APP_IMAGE=
APP_PORT_HOST=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
