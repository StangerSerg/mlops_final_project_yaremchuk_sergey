    "test_size": 0.2
  },
  "model_params": {
    "depth": 4,
    "learning_rate": 0.1,
    "loss_function": "Logloss",
    "verbose": false
  },
  "required_columns": [
    "views",
    "purchases",
    "categoryid",
    "available"
  ],
  "numeric_columns": []
}