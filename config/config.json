{
  "events_file": "events.csv",
  "item_props_file": "item_properties_part1.csv",
  "item_features_file": "item_features.parquet",
  "train_file": "data_for_training.parquet",
  "model_file": "ranker.pkl",
  "window_hours": 24,
  "target": "target",
  "features": ["views", "purchases", "ctr", "hour", "weekday", "categoryid", "available"],
  "split_params": {
    "random_state": 42,
    "test_size": 0.2
  },
  "model_params": {
    "depth": 4,
    "learning_rate": 0.1,
    "loss_function": "Logloss",
    "verbose": false
  },
  "required_columns": [
    "views",
    "purchases",
    "categoryid",
    "available"
  ]
}
