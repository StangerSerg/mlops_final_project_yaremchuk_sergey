{
  "events_path": "data/raw/events.csv",
  "item_props_path": "data/raw/item_properties_part1.csv",
  "out_item_feats_path":  "data/prepared/item_features.parquet",
  "out_train_path":  "data/prepared/data_for_training.parquet",
  "window_hours": 24,
  "output_model_path": "models/ranker.pkl",
  "target": "target",
