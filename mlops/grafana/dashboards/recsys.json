{
  "uid": "recsys-main",
  "title": "Retail RecSys",
  "tags": [
    "recsys",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
